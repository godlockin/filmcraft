# FilmCraft server — local development environment variables.
#
# Copy to .env and fill in. Never commit .env.

# ---------- listen address ----------
# This value is used by `cargo run -p filmcraft-server` on the host. It is
# deliberately NOT picked up by `docker compose up` — the compose file
# hard-codes `0.0.0.0:8080` for the in-container server (so the published
# port is reachable from the host), while keeping the host-side bind at
# `127.0.0.1:8080:8080` (so the public internet never sees the service).
# If you need to override the in-container bind, edit docker-compose.yml.
# Loopback by default. Override to "0.0.0.0:8080" only when behind a reverse
# proxy you control (AGENTS.md §0: never expose the engine to the public
# internet without an authenticated front door).
FILMCRAFT_LISTEN_ADDR=127.0.0.1:8080

# ---------- logging ----------
# RUST_LOG syntax: target=level,target2=level,...
# Verbose options while developing:
#   RUST_LOG=filmcraft_server=debug,tower_http=debug,axum=trace
RUST_LOG=filmcraft_server=info,tower_http=info

# ---------- OSS (M1.3 — leave empty in M1 hello-world) ----------
# FILMCRAFT_OSS_BUCKET=
# FILMCRAFT_OSS_ENDPOINT=
# FILMCRAFT_OSS_ACCESS_KEY_ID=
# FILMCRAFT_OSS_ACCESS_KEY_SECRET=

# ---------- 百炼 / Bailian (M3 — leave empty in M1) ----------
# BAILIAN_API_KEY=
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL=qwen-max
